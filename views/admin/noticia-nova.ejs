<h1 class="page-title">➕ Nova Notícia</h1>

<div class="form-card">
  <form action="/admin/noticias/nova" method="POST">

    <% if (error) { %>
      <p class="form-error"><%= error %></p>
    <% } %>

    <label class="form-label">Título</label>
    <input type="text" name="titulo" required class="form-input">

    <label class="form-label">Conteúdo</label>
    <textarea name="conteudo" rows="6" required class="form-input"></textarea>

    <label class="form-label">URL da Imagem (opcional)</label>
    <input type="text" name="imagem_url" class="form-input">

    <button type="submit" class="btn-primary">Salvar</button>
  </form>

  <div class="back-link">
    <a href="/admin/noticias">← Voltar</a>
  </div>
</div>
