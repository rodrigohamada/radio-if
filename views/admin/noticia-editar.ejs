<h1 class="page-title">✏️ Editar Notícia</h1>

<div class="form-card">
  <form action="/admin/noticias/editar/<%= noticia.id %>" method="POST">

    <% if (error) { %>
      <p class="form-error"><%= error %></p>
    <% } %>

    <label class="form-label">Título</label>
    <input type="text" name="titulo" value="<%= noticia.titulo %>" required class="form-input">

    <label class="form-label">Conteúdo</label>
    <textarea name="conteudo" rows="6" required class="form-input"><%= noticia.conteudo %></textarea>

    <label class="form-label">URL da Imagem (opcional)</label>
    <input type="text" name="imagem_url" value="<%= noticia.imagem_url || '' %>" class="form-input">

    <button type="submit" class="btn-primary">Atualizar</button>
  </form>

  <div class="back-link">
    <a href="/admin/noticias">← Voltar</a>
  </div>
</div>
